/**
 * Wrangler 配置示例
 *
 * 使用方式:
 * 1. 复制本文件为 wrangler.jsonc
 * 2. 修改 name、routes、KV/D1 资源 ID 等项目专属配置
 * 3. 敏感变量请使用 Cloudflare Dashboard 或 wrangler secret put 设置
 *
 * 常用命令:
 * - pnpm dev
 * - pnpm deploy
 * - pnpm cf-typegen
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ws-vless",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-17",
  "compatibility_flags": ["enable_request_signal"],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    },
    "logs": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "./public/",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": [
      "/",
      "/ws*",
      "/x*",
      "/api/*",
      "/node/xray/start",
      "/node/xray/stop",
      "/node/handler/add-user",
      "/node/handler/add-users",
      "/node/handler/remove-user",
      "/node/handler/remove-users",
      "/node/handler/drop-users-connections",
      "/node/handler/drop-ips",
      "/node/handler/get-inbound-users-count",
      "/node/handler/get-inbound-users",
      "/node/plugin/sync",
      "/node/plugin/torrent-blocker/collect",
      "/node/plugin/nftables/block-ips",
      "/node/plugin/nftables/unblock-ips",
      "/node/plugin/nftables/recreate-tables",
      "/node/stats/get-users-stats",
      "/node/stats/get-combined-stats",
      "/node/stats/get-inbound-stats",
      "/node/stats/get-outbound-stats",
      "/node/stats/get-all-inbounds-stats",
      "/node/stats/get-all-outbounds-stats"
    ]
  },
  "keep_vars": true,
  "workers_dev": true,
  "preview_urls": true,
  /**
   * 自定义域名路由，可按需开启。
   * https://developers.cloudflare.com/workers/configuration/routing/routes/
   */
  // "routes": [
  //   {
  //     "pattern": "worker.example.com/*",
  //     "zone_name": "example.com"
  //   }
  // ],
  /**
   * KV 命名空间绑定（可选，作为 UUID L2 缓存）。
   *
   * 创建命令:
   *   wrangler kv namespace create UUID_KV
   */
  // "kv_namespaces": [
  //   {
  //     "binding": "UUID_KV",
  //     "id": "<your-kv-namespace-id>"
  //   }
  // ],
  /**
   * D1 数据库绑定（可选，用于流量统计或缓存持久化）。
   *
   * 创建命令:
   *   wrangler d1 create ws-vless-traffic
   */
  // "d1_databases": [
  //   {
  //     "binding": "TRAFFIC_D1",
  //     "database_name": "ws-vless-traffic",
  //     "database_id": "<your-d1-database-id>",
  //     "migrations_dir": "./migrations"
  //   }
  // ],
  /**
   * Smart Placement（可选）。
   * https://developers.cloudflare.com/workers/configuration/smart-placement/
   */
  // "placement": {
  //   "mode": "smart"
  // },
  /**
   * 非敏感环境变量。
   *
   * 敏感值不要写入 wrangler.jsonc，建议使用:
   * - wrangler secret put API_KEY
   * - wrangler secret put RW_API_KEY
   * - wrangler secret put STATS_REPORT_TOKEN
   */
  "vars": {
    "DEV_MODE": "false",
    "LOG_LEVEL": "WARN",
    "MUX_ENABLED": "true",
    "RW_API_URL": "https://your-remnawave-panel.example.com",
    "SUBREQUEST_LIMIT": "48",
    "UUID_CACHE_TTL": "300"
  }
}
